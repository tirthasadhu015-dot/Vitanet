# Flask application settings
FLASK_APP=app.py
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret

# MongoDB
MONGO_URI=mongodb://localhost:27017/vitanet
MONGO_CONNECT_TIMEOUT_MS=5000

# Gemini API
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# DigitalOcean Spaces (S3-compatible object storage)
DO_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=replace-with-your-space-name
DO_SPACES_KEY=replace-with-your-spaces-access-key
DO_SPACES_SECRET=replace-with-your-spaces-secret-key
MAX_UPLOAD_SIZE_MB=10

# Solana RPC proxy
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
SOLANA_ESCROW_PRIVATE_KEY=replace-with-your-escrow-private-key
SOLANA_NETWORK=devnet
